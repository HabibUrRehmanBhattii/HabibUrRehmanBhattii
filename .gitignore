```gitignore
# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Dependencies
node_modules/
__pycache__/
.mypy_cache/
.pytest_cache/
.venv/
venv/
target/
.gradle/

# Compiled and build artifacts
*.pyc
*.class
*.o
*.obj
*.out
dist/
build/
coverage/
htmlcov/
*.so
*.dll
*.exe

# System files
.DS_Store
Thumbs.db

# Original rules preserved
*.log
```